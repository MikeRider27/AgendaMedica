# Copiar a .env y completar. No versionar .env.
DB_NAME=agenda_medica
DB_USER=agenda
DB_PASSWORD=cambiar-esta-clave

# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRACION_HORAS=10

# Administrador inicial (se crea sólo si no hay usuarios)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

TZ=America/Asuncion
WEB_PORT=8080

# Subredes de docker (cambiar si chocan con otras redes del host)
SUBNET_INTERNA=10.89.50.0/24
SUBNET_PUBLICA=10.89.51.0/24
